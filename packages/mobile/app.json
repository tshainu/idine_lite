{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.idinelite_r7k2.runable",
      "versionCode": 15,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A73C8"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "apiUrl": "http://69.169.97.195",
      "eas": {
        "projectId": "28821494-1a4f-4419-aa71-b1eb0a9226cd"
      },
      "router": {}
    },
    "ios": {
      "bundleIdentifier": "com.idinelite_r7k2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A73C8"
    },
    "name": "iDine Lite",
    "slug": "idine-lite",
    "version": "1.0.0",
    "scheme": "idine-lite",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow iDine Lite to access your photos to add item images.",
          "cameraPermission": "Allow iDine Lite to use the camera to take item photos."
        }
      ],
      "expo-document-picker"
    ],
    "owner": "tshainoo"
  }
}